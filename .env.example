# Copy to .env.local for local dev. These three are BUILD-TIME and end up in
# the bundle — that is by design: the publishable key is public-safe and RLS
# is the security boundary.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Web Push (Sprint 4). Public half of the VAPID pair only.
VITE_VAPID_PUBLIC_KEY=

# NEVER put these in a VITE_ variable or in this file's committed form —
# they live in Supabase Edge Function secrets only:
#   ANTHROPIC_API_KEY      (plaka-oku)
#   KAMERA_WEBHOOK_SECRET  (kamera-webhook)
#   PUSH_SECRET, VAPID_PRIVATE_KEY, VAPID_PUBLIC_KEY, VAPID_SUBJECT (send-push)
#   SUPABASE_SERVICE_ROLE_KEY (injected automatically by Supabase)
